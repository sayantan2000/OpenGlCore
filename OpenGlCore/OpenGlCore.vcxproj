  <!-- Copy runtime assets next to the executable so the app can be run by double-click.
       Shaders/textures are loaded via paths relative to the working directory. -->
  <Target Name="CopyRuntimeAssets" AfterTargets="Build">
    <ItemGroup>
      <_ShaderFiles Include="$(ProjectDir)Shader\**\*" />
      <_ImageFiles Include="$(ProjectDir)Images\**\*" />
      <_FontFiles Include="$(ProjectDir)Fonts\**\*" />
      <_ModelFiles Include="$(ProjectDir)Models\**\*" />
      <_SkyboxFiles Include="$(ProjectDir)SKYBOX\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_ShaderFiles)" DestinationFiles="@(_ShaderFiles->'$(OutDir)Shader\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ImageFiles)" DestinationFiles="@(_ImageFiles->'$(OutDir)Images\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_ModelFiles)" DestinationFiles="@(_ModelFiles->'$(OutDir)Models\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_ModelFiles)' != ''" />
    <Copy SourceFiles="@(_SkyboxFiles)" DestinationFiles="@(_SkyboxFiles->'$(OutDir)SKYBOX\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_SkyboxFiles)' != ''" />
    <Copy SourceFiles="@(_FontFiles)" DestinationFiles="@(_FontFiles->'$(OutDir)Fonts\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" Condition="'@(_FontFiles)' != ''" />
  </Target>
  <!-- Copy vcpkg runtime DLLs (Assimp + its dependencies) next to the executable. -->
  <Target Name="CopyVcpkgDlls" AfterTargets="Build" Condition="'$(Platform)'=='x64'">
    <PropertyGroup>
      <_VcpkgBin Condition="'$(Configuration)'=='Debug'">$(ProjectDir)..\vcpkg_installed\x64-windows\debug\bin</_VcpkgBin>
      <_VcpkgBin Condition="'$(Configuration)'=='Release'">$(ProjectDir)..\vcpkg_installed\x64-windows\bin</_VcpkgBin>
    </PropertyGroup>
    <ItemGroup>
      <_VcpkgDlls Include="$(_VcpkgBin)\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_VcpkgDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(_VcpkgDlls)' != ''" />
  </Target>
